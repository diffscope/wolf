{
    "interface": "org.openvpi.wolf.inference.G2P",
    "level": 1,
    "variant": "pipe-chain",
    "name": "German G2P over the shared model",
    "exports": {
        "languages": [
            {
                "language": "deu",
                "scheme": "ds"
            }
        ]
    },
    "configuration": {
        "formatVersion": 1,
        "steps": [
            {
                "step": "verify",
                "params": {
                    "entries": [
                        {
                            "type": "regex",
                            "value": [
                                "([A-Za-z']+)"
                            ],
                            "mode": "convert"
                        }
                    ]
                }
            },
            {
                "step": "model",
                "params": {
                    "role": "backend"
                }
            }
        ]
    },
    "imports": [
        {
            "role": "backend",
            "ref": "wolf/g2p-multi:inference/multig2p"
        }
    ]
}
