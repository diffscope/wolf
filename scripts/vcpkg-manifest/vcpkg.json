{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "dependencies": [
        "blake3",
        "cpp-pinyin",
        "luajit",
        "qmsetup",
        "re2",
        "stdcorelib",
        "stdcorelib-plugin",
        "synthrt-main"
    ],
    "features": {
        "onnx": {
            "description": "Build the model backed G2P variant, which needs dsinfer and its ONNX Runtime driver",
            "dependencies": [
                {
                    "name": "synthrt-main",
                    "default-features": false,
                    "features": [
                        "onnx"
                    ]
                }
            ]
        },
        "lang-packages": {
            "description": "Install the published language resource packages through the port instead of pointing WOLF_LANG_PACKAGES_SOURCE at a local copy. Needs the release to be public.",
            "dependencies": [
                "wolf-lang-packages"
            ]
        },
        "tests": {
            "description": "Enable test cases support",
            "dependencies": [
                "boost-test"
            ]
        }
    },
    "vcpkg-configuration": {
        "overlay-ports": [
            "../vcpkg-ports",
            "../vcpkg/ports"
        ],
        "overlay-triplets": [
            "../vcpkg/triplets"
        ]
    }
}
